# Database URL (Automatically provided by Railway PostgreSQL)
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway
DATABASE_URL=

# Port assigned by Railway (Defaults to 5000 if not set)
PORT=5000

# Security secret for JWT tokens
JWT_SECRET=rks-production-secret-jwt-key-2026

# Environment
NODE_ENV=production
